# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Secret for "Lost access to Google Authenticator?" on the director login. Pick a long random value.
DIRECTOR_RECOVERY_CODE=

# Public address of the deployed site, used in password-reset emails (no trailing slash)
NEXT_PUBLIC_APP_URL=
